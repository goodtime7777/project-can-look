{
  "name": "dsh-projectmap",
  "version": "0.1.1",
  "private": true,
  "description": "把项目地图挂到 DeepSeek Harness 自己的 web 服务上：同源、无独立端口、无额外进程",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "projectmap"],
  "license": "MIT"
}
